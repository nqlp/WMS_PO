{
  "name": "ezoko-po-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate && prisma generate --config=prisma.config.ezoko.ts",
    "dev": "next dev",
    "build": "prisma generate && prisma generate --config=prisma.config.ezoko.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:generate:ezoko": "prisma generate --schema=prisma/schema-ezoko.prisma",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "jose": "^5.9.6",
    "next": "^15.5.12",
    "papaparse": "^5.5.3",
    "pg": "^8.18.0",
    "prisma": "^7.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.7",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.8",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}