generator ezokoClient {
    provider = "prisma-client-js"
    output   = "../node_modules/@prisma/ezoko-client"
}

datasource db {
    provider = "postgresql"
}

enum Activity {
    CORRECTION
    MOVEMENT
    GOODS_RECEIPT
    PUTAWAY
    PICKING
    GOODS_ISSUE
    INV_COUNTING
}

model StockMovementLog {
    id                  String   @id
    createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    user                String?  @db.Text
    activity            Activity
    barcode             String?  @db.Text
    variantTitle        String?  @map("variant_title") @db.Text
    srcLocation         String?  @map("src_location") @db.Text
    srcQty              Int?     @map("src_qty")
    destinationLocation String?  @map("destination_location") @db.Text
    destinationQty      Int?     @map("destination_qty")
    referenceDoc        String?  @db.Text

    @@map("stock_movement_log")
}
